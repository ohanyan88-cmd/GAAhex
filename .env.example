# ENVIRONMENT defaults to "production" (fail-closed). Local dev MUST declare itself, or the boot
# refuses the weak dev secrets below. Use development/test/dev/ci/local; anything else is strict.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://gaahex:gaahex@localhost:5433/gaahex
OWNER_DATABASE_URL=postgresql+asyncpg://gaahex:gaahex@localhost:5433/gaahex
REDIS_URL=redis://localhost:6380/0
JWT_SECRET=change-me-dev-secret
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=8
REQUIRE_STRONG_SECRETS=false
CORS_ORIGINS=*
WEBHOOK_ALLOW_PRIVATE=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MIN=6000
