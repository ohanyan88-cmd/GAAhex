# GAAex Portal — production environment variables
# Copy this file to .env on the production server and fill every value.
# NEVER commit a filled .env to git.
# Lines starting with # are comments; remove them before deploying if your env loader is strict.

# ── FRONTEND ──────────────────────────────────────────────────────────────────
# Frontend API base URL — the browser hits this. Must be reachable from browsers.
VITE_API_BASE=https://api.yourdomain.com

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Application user (limited privileges — RLS enforced).
# Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://gaaex_app:CHANGE_ME@localhost:5432/gaaex

# Owner/superuser role (bypasses RLS for seed + login pre-auth paths only).
# In prod: DATABASE_URL=gaaex_app, this=gaaex (the DB owner).
OWNER_DATABASE_URL=postgresql+asyncpg://gaaex:CHANGE_ME@localhost:5432/gaaex

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT / AUTH ────────────────────────────────────────────────────────────────
# MUST be at least 32 random bytes. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_OF_RANDOM

# Enforce strong-secret check on startup (prevents booting with the dev default).
REQUIRE_STRONG_SECRETS=true

# Access token lifetime in minutes (default 60).
ACCESS_TOKEN_MINUTES=60

# Refresh token lifetime in days (default 14).
REFRESH_TOKEN_DAYS=14

# ── FIELD-LEVEL ENCRYPTION ────────────────────────────────────────────────────
# Fernet symmetric key for encrypting sensitive fields at rest (api_key.key_enc, webhook.secret_enc, …).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy in a secure vault (AWS Secrets Manager, HashiCorp Vault, etc.).
# Key rotation: generate a new key, re-encrypt all encrypted columns, swap here, redeploy.
GAAEX_FIELD_KEY=CHANGE_ME_FERNET_BASE64_KEY

# ── SINGLE TENANT ─────────────────────────────────────────────────────────────
# Optional: pin the one tenant UUID so the app doesn't query the DB on every startup.
# Recommended in production. Get it from: SELECT id FROM tenant LIMIT 1;
# GAAEX_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Do NOT use * in production.
CORS_ORIGINS=https://app.yourdomain.com

# ── RATE LIMITING ─────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=600

# ── EMAIL (SMTP) ──────────────────────────────────────────────────────────────
# Leave EMAIL_PROVIDER=dev to disable real sending (logs only).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=GAAex <noreply@yourdomain.com>
SMTP_STARTTLS=true

# ── SMS (TWILIO) ───────────────────────────────────────────────────────────────
# Leave SMS_PROVIDER=dev to disable real sending (logs only).
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM=+1XXXXXXXXXX

# ── AI ASSIST ─────────────────────────────────────────────────────────────────
# Providers: none (deterministic fallback) | gemini | openai | anthropic | groq
# "none" disables all external AI calls — safe default.
AI_PROVIDER=gemini
AI_API_KEY=CHANGE_ME
# AI_MODEL=gemini-2.0-flash-latest   # override only if needed
# AI_BASE_URL=                       # proxy / self-hosted endpoint

# ── SCHEDULER ────────────────────────────────────────────────────────────────
# Auto-fires billing cycle + dunning sweeps per tenant.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600

# ── PAYMENT GATEWAYS ──────────────────────────────────────────────────────────
# Set PAYMENT_PROVIDER to the active gateway. Only one gateway is active at a time per install.
# Credential slots for all gateways are listed below; fill only the active one.
PAYMENT_PROVIDER=dev   # dev | arca | idram | telcell | easypay

# Public base URL the gateway POSTs payment callbacks to (must be reachable from the internet).
PAYMENT_CALLBACK_BASE_URL=https://app.yourdomain.com

# ARCA (Armenian card processing)
ARCA_MERCHANT=CHANGE_ME
ARCA_PASSWORD=CHANGE_ME

# iDram (Armenian wallet)
IDRAM_MERCHANT_ID=CHANGE_ME
IDRAM_SECRET_KEY=CHANGE_ME

# TelCell (Armenian telecom wallet)
TELCELL_MERCHANT=CHANGE_ME
TELCELL_KEY=CHANGE_ME

# EasyPay (add credentials when adapter is complete)
# EASYPAY_MERCHANT_ID=CHANGE_ME
# EASYPAY_SECRET_KEY=CHANGE_ME

# ── WEBHOOKS ──────────────────────────────────────────────────────────────────
# Allow webhooks to fire at private/loopback addresses (only safe in trusted internal networks).
WEBHOOK_ALLOW_PRIVATE=false
