# GAAhex Portal — PRODUCTION environment reference (ops source of truth)
# Copy this file to `.env` on the production host, then fill EVERY placeholder.
# All values below are PLACEHOLDERS. Never commit a filled .env to git.
# Generate secrets on a trusted machine; store backups in a vault (Vault / AWS SM).
# Loader: pydantic-settings (backend/app/config.py). Case-insensitive, KEY=VALUE.

# ─── ENVIRONMENT + SAFETY GUARDS ──────────────────────────────────────────────
# MUST be "production" — this trips the M1-A deploy contract in app/main.py:56
# (refuses boot if DATABASE_URL == OWNER_DATABASE_URL or share the same role).
ENVIRONMENT=production

# Hard-fail boot on weak JWT secret OR if the app DB role is a superuser.
# In production this MUST remain true. Set false only for staging smoke runs.
REQUIRE_STRONG_SECRETS=true

# Comma-separated allow-list of browser origins. NEVER use "*" in production.
# Include every public hostname the SPA is served from (apex + www if both used).
CORS_ORIGINS=https://app.yourdomain.com,https://portal.yourdomain.com

# Frontend bundle's API base — baked into the SPA at build time, not runtime.
# (Documented here so the deploy pipeline reads the same source of truth.)
VITE_API_BASE=https://api.yourdomain.com

# ─── DATABASE (two roles, MUST DIFFER in production) ──────────────────────────
# App role: gaahex_app — NOSUPERUSER, NOBYPASSRLS. Used for every request.
# RLS policies only filter rows when the connecting role lacks BYPASSRLS.
# Format: postgresql+asyncpg://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://gaahex_app:REPLACE_WITH_APP_ROLE_PASSWORD@db.internal:5432/gaahex

# Owner role: gaahex — SUPERUSER. Used ONLY for: alembic migrations, seeding,
# and the pre-auth user-lookup path. NEVER share the URL or role with the app.
# Boot will REFUSE if this equals DATABASE_URL or shares its username in prod.
OWNER_DATABASE_URL=postgresql+asyncpg://gaahex:REPLACE_WITH_OWNER_ROLE_PASSWORD@db.internal:5432/gaahex

# ─── CACHE / REDIS ────────────────────────────────────────────────────────────
# Used for rate-limit counters, refresh-token rotation, and short-lived caches.
# Use a dedicated DB index (e.g. /0) and password-protect Redis in production.
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis.internal:6379/0

# ─── AUTH + CRYPTO ────────────────────────────────────────────────────────────
# JWT signing secret — HS256 HMAC. MUST be 32+ random bytes.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_TOKEN_URLSAFE_48_OUTPUT

# Access token TTL in minutes (short-lived). Refresh extends the session.
ACCESS_TOKEN_MINUTES=60

# Refresh token TTL in days (rotating; revoked on logout).
REFRESH_TOKEN_DAYS=14

# Password policy: minimum subscriber/staff password length.
PASSWORD_MIN_LENGTH=12

# Field-level encryption key (Fernet, 32-byte url-safe base64). Used for
# api_key.key_enc, webhook.secret_enc, and other secrets-at-rest columns.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation runbook: backend/scripts/rotate_field_key.py. Back up to a vault.
GAAHEX_FIELD_KEY=REPLACE_WITH_FERNET_GENERATE_KEY_OUTPUT

# Optional: pin the single tenant UUID to skip a DB round-trip at startup.
# Recommended in prod. Resolve once with: SELECT id FROM tenant LIMIT 1;
# GAAHEX_TENANT_ID=00000000-0000-0000-0000-000000000000

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
# Per-principal-or-IP, fixed 1-minute window. Tune to expected peak RPS.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=600

# ─── PAYMENTS — STRIPE (M1-C gateway, vault-card flow) ────────────────────────
# Active gateway for subscriber card payments. In prod use LIVE keys.
# Options: mock | logging | stripe
PAYMENT_GATEWAY_PROVIDER=stripe

# pk_live_... — embedded in frontend (Stripe Elements). Safe to expose.
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_STRIPE_LIVE_PUBLISHABLE_KEY

# sk_live_... — SERVER ONLY. Never log, never ship to frontend.
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_LIVE_SECRET_KEY

# whsec_... — endpoint secret from the Stripe webhook dashboard.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# Lock to a known API version to avoid surprise breakage on Stripe upgrades.
STRIPE_API_VERSION=2024-06-20

# ─── PAYMENTS — LEGACY REDIRECT GATEWAYS (Armenian rails, optional) ──────────
# Independent of the Stripe gateway above. Set provider to engage one; leave
# at "dev" for deterministic DevGateway behavior.
# Options: dev | arca | idram | telcell | easypay
PAYMENT_PROVIDER=dev

# Public callback base URL — provider POSTs here after redirect-flow payments.
PAYMENT_CALLBACK_BASE_URL=https://app.yourdomain.com

# ARCA (Armenian card processing)
ARCA_MERCHANT=REPLACE_OR_LEAVE_BLANK_IF_INACTIVE
ARCA_PASSWORD=REPLACE_OR_LEAVE_BLANK_IF_INACTIVE

# iDram (Armenian wallet)
IDRAM_MERCHANT_ID=REPLACE_OR_LEAVE_BLANK_IF_INACTIVE
IDRAM_SECRET_KEY=REPLACE_OR_LEAVE_BLANK_IF_INACTIVE

# TelCell (Armenian telecom wallet)
TELCELL_MERCHANT=REPLACE_OR_LEAVE_BLANK_IF_INACTIVE
TELCELL_KEY=REPLACE_OR_LEAVE_BLANK_IF_INACTIVE

# EasyPay (adapter pending — leave blank until live)
# EASYPAY_MERCHANT_ID=
# EASYPAY_SECRET_KEY=

# ─── SMS — TWILIO (M1-C gateway) ──────────────────────────────────────────────
# Options: mock | twilio
SMS_GATEWAY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_LIVE_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_LIVE_AUTH_TOKEN
# Either a from number (E.164) OR a Messaging Service SID — not both.
TWILIO_FROM_NUMBER=+374REPLACEXXX
TWILIO_MESSAGING_SERVICE_SID=
# Public URL Twilio POSTs delivery-status webhooks to.
TWILIO_STATUS_CALLBACK_URL=https://api.yourdomain.com/webhooks/twilio/status
# Used to verify X-Twilio-Signature on inbound webhooks.
TWILIO_WEBHOOK_AUTH_TOKEN=REPLACE_WITH_WEBHOOK_AUTH_TOKEN

# Legacy SMS switch (channels.py). Mirror provider above during migration.
# Options: dev | twilio
SMS_PROVIDER=twilio
TWILIO_FROM=+374REPLACEXXX

# ─── EMAIL — SENDGRID (M1-C gateway) ──────────────────────────────────────────
# Options: mock | sendgrid
EMAIL_GATEWAY_PROVIDER=sendgrid
SENDGRID_API_KEY=SG.REPLACE_WITH_LIVE_API_KEY
SENDGRID_FROM_EMAIL=billing@yourdomain.com
SENDGRID_FROM_NAME=GAAhex Billing
# ECDSA public key for verifying SendGrid event webhooks.
SENDGRID_WEBHOOK_PUBLIC_KEY=REPLACE_WITH_ECDSA_PUBLIC_KEY

# Legacy SMTP switch (channels.py). Options: dev | smtp
# Leave at "dev" if all outbound mail goes via SendGrid above.
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ─── RADIUS — FREERADIUS (subscriber AAA) ─────────────────────────────────────
# Options: mock | freeradius
RADIUS_BACKEND_PROVIDER=freeradius
RADIUS_HOST=radius.internal
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
# Shared secret between this app and the FreeRADIUS server (16+ chars).
RADIUS_SECRET=REPLACE_WITH_RADIUS_SHARED_SECRET
# Our NAS-IP-Address attribute — the source IP FreeRADIUS sees from us.
RADIUS_NAS_IP=10.0.0.10
# Path inside the container to RADIUS dictionary files (vendor attributes).
RADIUS_DICTIONARY_PATH=/etc/freeradius/dictionary

# ─── AI ASSIST (optional) ─────────────────────────────────────────────────────
# Options: none | openai | anthropic | gemini | groq
# "none" disables every external AI call — deterministic rule-based fallback.
AI_PROVIDER=none
AI_API_KEY=
# AI_MODEL=gemini-2.0-flash-latest   # provider-specific override
# AI_BASE_URL=                       # proxy / self-hosted / Azure endpoint

# ─── SCHEDULER (billing cycles, dunning sweeps) ───────────────────────────────
# Required ON in prod — auto-fires run-cycle / run-due / run-dunning per tenant.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=3600

# ─── ATTACHMENT STORAGE ───────────────────────────────────────────────────────
# v1 default 'local' = single-node only. Multi-node ⇒ 'minio' or 's3'.
# Options: local | minio | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/uploads
# MinIO (self-hosted S3-compatible) — fill if STORAGE_BACKEND=minio
STORAGE_MINIO_ENDPOINT=
STORAGE_MINIO_ACCESS_KEY=
STORAGE_MINIO_SECRET_KEY=
STORAGE_MINIO_BUCKET=portal-attachments
STORAGE_MINIO_SECURE=true
# AWS S3 — fill if STORAGE_BACKEND=s3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Max upload size per file (bytes). Default = 100 MB.
STORAGE_MAX_FILE_BYTES=104857600

# ─── WEBHOOKS (SSRF guard) ────────────────────────────────────────────────────
# Block outbound webhooks to private/loopback/reserved IPs. Keep FALSE in prod
# unless your network legitimately requires internal-target webhooks.
WEBHOOK_ALLOW_PRIVATE=false

# ─── FIRST-BOOT CHECKLIST (run in order) ──────────────────────────────────────
# 1. Generate JWT_SECRET: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# 2. Generate GAAHEX_FIELD_KEY: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
#    Store both in your secrets vault BEFORE pasting here.
# 3. Create the two Postgres roles:
#       CREATE ROLE gaahex      SUPERUSER LOGIN PASSWORD '...';
#       CREATE ROLE gaahex_app  LOGIN NOSUPERUSER NOBYPASSRLS PASSWORD '...';
#       GRANT USAGE ON SCHEMA public TO gaahex_app;
#       GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO gaahex_app;
# 4. Run migrations as OWNER:  `DATABASE_URL=$OWNER_DATABASE_URL alembic upgrade head`
# 5. Seed the demo/initial tenant, then capture its UUID into GAAHEX_TENANT_ID (optional).
# 6. Boot the API — `_assert_production_deploy_contract()` MUST pass silently.
#    If it raises, DATABASE_URL and OWNER_DATABASE_URL still share a role: fix and retry.
# 7. Smoke-test: POST /auth/login, verify rate-limit headers, fire a Stripe test webhook,
#    confirm SendGrid + Twilio + FreeRADIUS each return 2xx / Access-Accept.
